# =============================================================================
# LOCAL DEVELOPMENT vs PRODUCTION
# =============================================================================
# The values below are LOCAL DEVELOPMENT defaults (MySQL, debug on, mail captured
# in memory). Do NOT copy this file to a production server unchanged.
#
# On production (Z.com + Supabase) the server's own .env must override, at least:
#   APP_ENV=production            APP_DEBUG=false
#   APP_URL=https://pupbccarelink.org   FRONTEND_URL=https://pupbccarelink.org
#   APP_KEY / JWT_SECRET / KIOSK_DEVICE_TOKEN   generated per environment (never reuse local ones)
#   LOG_CHANNEL=daily or stderr, LOG_LEVEL=warning or error
#   DB_CONNECTION=pgsql + the SUPABASE_DB_* block further down
#   MAIL_MAILER=smtp, EMAIL_TEST_MODE=false, real MAIL_* credentials
#   SANCTUM_STATEFUL_DOMAINS=pupbccarelink.org
# The production .env lives only on the server. Never commit it, and never put a
# secret in a VITE_* variable: those are compiled into the public browser bundle.
# Full steps: ZCOM_SUPABASE_DEPLOYMENT_GUIDE.md
# =============================================================================

APP_NAME="PUPBC CareLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carelink
DB_USERNAME=root
DB_PASSWORD=

# Supabase PostgreSQL (production). Its own SUPABASE_DB_* names, so both blocks can
# stay filled in; DB_CONNECTION picks which one the app uses (pgsql = Supabase).
# Use the Supabase SESSION pooler on port 5432. Port 6543 is the transaction pooler;
# render.yaml in this repo records prepared-statement errors on it, and the persistent
# connection option below is for session mode only. So do not use 6543.
# Region: Southeast Asia (Singapore), the same region as the Render backend.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_PERSISTENT=false   # config/database.php reads this; keep false on shared hosting

# Local: mail is captured in memory (MAIL_MAILER=array) and EMAIL_TEST_MODE reroutes
# every message to EMAIL_TEST_RECIPIENT. Production: MAIL_MAILER=smtp and
# EMAIL_TEST_MODE=false, otherwise OTP / password-reset emails never reach students.
MAIL_MAILER=array
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=delivered@resend.dev
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="PUPBC CareLink"
# Email nurses a copy of new bookings, student cancellations and medicine stock/expiry alerts.
# Set to false to switch the nurse emails off; the in-app notifications are unaffected.
NURSE_EMAIL_NOTIFICATIONS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=localhost:5173
KIOSK_DEVICE_TOKEN=
# Production: password ng seeded nurse account (default "nurse").
# SEED_NURSE_PASSWORD=

SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
CLINIC_OPEN_DAYS="Monday to Saturday"
CLINIC_CLOSED_DAYS=Sunday
LUNCH_START=12:00
LUNCH_END=13:00
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10

# Clinic assistant (AI chatbot) - Ollama provider. Get API key at https://ollama.com
# Leave OLLAMA_API_KEY empty to keep the assistant in "not configured" mode.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
# Comma-separated fallback chain. Tried in order when a model is rate limited
# (HTTP 429), missing, or briefly overloaded (5xx).
OLLAMA_FALLBACK_MODELS=gemma4:31b
# Seconds to skip a model after it reports a rate limit (0 disables the skip).
OLLAMA_RATE_LIMIT_COOLDOWN=60
OLLAMA_TIMEOUT=30
OLLAMA_MAX_OUTPUT_TOKENS=1024

# Gemini: fallback when Ollama cannot answer (no credits, rate limit, outage).
# Get a key at https://aistudio.google.com/apikey. Empty = Ollama only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_RATE_LIMIT_COOLDOWN=60
GEMINI_TIMEOUT=20
GEMINI_MAX_OUTPUT_TOKENS=1024
CHATBOT_ENABLED=true
CHATBOT_RATE_LIMIT=5
CHATBOT_DAILY_LIMIT=15
# Ask Ollama for a JSON body so the reply and its follow-up questions arrive
# together and in the student's own language. Set to false if the model does
# not support JSON response mode.
CHATBOT_STRUCTURED_REPLIES=true
# Categorize described symptoms and label them with a triage level (green /
# yellow / red) using the same rules as the kiosk. Set to false to fall back to
# the plain assistant: replies still work, but without a category or badge.
CHATBOT_TRIAGE_ENABLED=true

# Public clinic contact address shown by the chatbot.
CLINIC_EMAIL=pupbinancarelink@gmail.com
