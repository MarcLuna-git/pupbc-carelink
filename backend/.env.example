APP_NAME="PUPBC CareLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carelink
DB_USERNAME=root
DB_PASSWORD=

# Production uses Supabase PostgreSQL. Set these only in the deployment environment.
# DB_CONNECTION=pgsql
# DB_HOST=your-project.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project
# DB_PASSWORD=your-supabase-password
# DB_SSLMODE=require
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

MAIL_MAILER=array
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=delivered@resend.dev
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="PUPBC CareLink"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=localhost:5173
KIOSK_DEVICE_TOKEN=
# Production: password ng seeded nurse account (default "nurse").
# SEED_NURSE_PASSWORD=

SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
LUNCH_START=12:00
LUNCH_END=13:00
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10
